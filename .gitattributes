# Build inputs and generated text use LF on Windows and Linux.
*.js text eol=lf
*.json text eol=lf
*.html text eol=lf
*.css text eol=lf
*.svg text eol=lf
*.md text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
.gitattributes text eol=lf
.gitignore text eol=lf

# Preserve recorded data and source evidence byte-for-byte, including newlines.
*.csv -text !eol
publication/sources/** -text !eol
research/reference/** -text !eol
